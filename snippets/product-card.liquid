{% assign card_variant = product.selected_or_first_available_variant %}<article class="product-card"><div class="product-media"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% else %}<div></div>{% endif %}</a><button class="wishlist-button" data-wishlist="{{ product.handle }}" aria-label="Save {{ product.title | escape }}" aria-pressed="false">♡</button>{% unless card_variant.available %}<span class="sold-out-badge">Sold out</span>{% endunless %}</div><div class="product-info"><a href="{{ product.url }}"><div class="product-title">{{ product.title }}</div><div class="product-type">{{ product.type | default: 'CartLane find' }}</div></a><div class="product-price">{{ card_variant.price | money }}{% if card_variant.compare_at_price > card_variant.price %}<del>{{ card_variant.compare_at_price | money }}</del>{% endif %}</div></div>{% if card_variant.available %}<form method="post" action="{{ routes.cart_add_url }}" class="product-card-form"><input type="hidden" name="id" value="{{ card_variant.id }}"><input type="hidden" name="quantity" value="1"><button class="button-outline" type="submit">Add to cart</button></form>{% else %}<button class="button-outline" disabled>Sold out</button>{% endif %}</article>
