<section class="section page-width"><div class="section-heading"><div><p class="eyebrow">The CartLane shelf</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p class="section-sub">{{ collection.description }}</p>{% endif %}</div><form method="get"><label class="eyebrow" for="SortBy">Sort by</label><select id="SortBy" name="sort_by" onchange="this.form.submit()"><option value="manual">Featured</option><option value="price-ascending">Price: low to high</option><option value="price-descending">Price: high to low</option><option value="title-ascending">Name: A to Z</option></select></form></div><div class="product-grid">{% paginate collection.products by 24 %}{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products found.</p>{% endfor %}{% endpaginate %}</div></section>{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
