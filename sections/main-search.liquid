<section class="section page-width"><p class="eyebrow">Find your next favorite</p><h1>Search the collection.</h1><form action="{{ routes.search_url }}" method="get" class="search-bar"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Name, type, or tag" aria-label="Search products"><input type="hidden" name="type" value="product"><button class="button-dark" type="submit">Search</button></form>{% if search.performed %}<p class="section-sub">{{ search.results_count }} results for “{{ search.terms }}”</p><div class="product-grid">{% paginate search.results by 24 %}{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}{% endpaginate %}</div>{% endif %}</section>{% schema %}{"name":"Main search","settings":[]}{% endschema %}
