{% assign featured_collection = collections[section.settings.collection] %}{% if featured_collection.products_count == 0 %}{% assign featured_collection = collections.all %}{% endif %}<section class="section page-width"><div class="hero"><div class="hero-copy"><p class="eyebrow">{{ settings.eyebrow }}</p><h1>{{ settings.hero_heading | newline_to_br }}</h1><p>{{ settings.hero_text }}</p><a class="button-dark" href="#catalog">Explore the edit <span>↗</span></a></div><div class="hero-media">{% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.hero_image.alt | default: 'CartLane collection' }}{% elsif featured_collection.products.first.featured_image %}{{ featured_collection.products.first.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: featured_collection.products.first.title }}{% endif %}</div></div></section><section class="benefits page-width"><div class="benefit"><strong>Free shipping</strong><span>Across India</span></div><div class="benefit"><strong>Cash on delivery</strong><span>Pay when delivered</span></div><div class="benefit"><strong>Easy returns</strong><span>Hassle-free support</span></div><div class="benefit"><strong>Secure payments</strong><span>Safe & protected</span></div></section><section id="catalog" class="section page-width"><div class="section-heading"><div><p class="eyebrow">The CartLane shelf</p><h2>{{ section.settings.collection_heading }}</h2><p class="section-sub">A few useful things to make daily life work a little better.</p></div><a class="button-outline" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">View all</a></div><div class="product-grid">{% for product in featured_collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% else %}<p>No products are available yet. Add products in Shopify to populate this collection.</p>{% endfor %}</div></section><section class="section dark-band"><div class="page-width"><div><p class="eyebrow">The CartLane promise</p><h2>Less noise. Better choices.</h2></div><div class="feature-grid"><div class="feature"><strong>Worth bringing home</strong><p>Products that solve a problem or add a little joy.</p></div><div class="feature"><strong>Easy to understand</strong><p>Clear details, honest availability, and no checkout surprises.</p></div><div class="feature"><strong>A real team behind it</strong><p>Questions answered by people, six days a week.</p></div></div></div></section>{% schema %}{"name":"CartLane homepage","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"collection","id":"collection","label":"Featured collection","default":"frontpage"},{"type":"text","id":"collection_heading","label":"Collection heading","default":"Small upgrades, picked for real life."},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":12,"step":4,"default":8}]}{% endschema %}
