<section class="section page-width"><div class="product-layout"><div class="product-gallery"><div class="product-thumbs">{% for image in product.images limit: 8 %}<button type="button" data-gallery-thumb="{{ image | image_url: width: 1400 }}" class="{% if forloop.first %}active{% endif %}"><img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy"></button>{% endfor %}</div><div class="product-main-image">{% if product.featured_image %}<img data-gallery-main src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}">{% endif %}</div></div><div><p class="eyebrow">{{ product.vendor | default: product.type | default: 'CartLane essential' }}</p><h1 class="product-title-large">{{ product.title }}</h1><div class="product-price-large">{{ product.selected_or_first_available_variant.price | money }}{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<del class="compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</del>{% endif %}</div>{% if product.available %}<p class="stock-note">In stock and ready to ship</p>{% else %}<p class="stock-note">Currently sold out</p>{% endif %}<div class="product-description">{{ product.description }}</div>{% form 'product', product, class: 'product-form' %}<label class="eyebrow" for="ProductSelect-{{ section.id }}">Choose an option</label><select id="ProductSelect-{{ section.id }}" name="id" class="variant-select">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><div class="product-actions"><div class="quantity" data-quantity><button type="button" data-direction="down" aria-label="Decrease quantity">−</button><input name="quantity" value="1" min="1" type="number" aria-label="Quantity"><button type="button" data-direction="up" aria-label="Increase quantity">+</button></div><button class="button-dark" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button></div>{% endform %}<div class="accordion"><details open><summary>Shipping & cash on delivery <span>⌄</span></summary><div>Free shipping across India. Cash on delivery is available on eligible orders.</div></details><details><summary>Easy returns & support <span>⌄</span></summary><div>Easy returns on eligible items. Contact {{ settings.support_email }} for help.</div></details><details><summary>Share <span>⌄</span></summary><div><button type="button" onclick="navigator.clipboard?.writeText(window.location.href)">Copy product link</button></div></details></div></div></div><div class="recommendations"><p class="eyebrow">Picked for this product</p><h2>You may also like.</h2><p class="section-sub">Related finds from the same Shopify catalog.</p><div class="product-grid">{% assign related_collection = product.collections.first %}{% for related_product in related_collection.products limit: 4 %}{% unless related_product.id == product.id %}{% render 'product-card', product: related_product %}{% endunless %}{% endfor %}</div></div><div class="reviews"><p class="eyebrow">Customer notes</p><h2>Loved by everyday shoppers.</h2><p class="section-sub">Connect a Shopify review app or product review metafield to show verified customer feedback here.</p><div class="review-grid"><article class="review-card"><strong>Shop with confidence</strong><p>Live product availability, secure Shopify checkout, and clear support from order to delivery.</p></article><article class="review-card"><strong>Cash on delivery</strong><p>Pay when your order arrives where COD is available for your address.</p></article><article class="review-card"><strong>Need help?</strong><p>Reach us at {{ settings.support_email }} or {{ settings.support_phone }}.</p></article></div></div></section>{% schema %}{"name":"Main product","settings":[]}{% endschema %}
