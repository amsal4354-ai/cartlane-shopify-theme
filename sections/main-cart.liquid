<section class="section page-width"><p class="eyebrow">Your selection</p><h1>Shopping bag.</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><table class="cart-table"><thead><tr><th>Product</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong><br><span class="section-sub">{{ item.variant.title }}</span></a></td><td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title }}"></td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table><div class="cart-actions"><button class="button-outline" type="submit" name="update">Update bag</button><a class="button-dark" href="{{ routes.checkout_url }}">Checkout securely · {{ cart.total_price | money }}</a></div></form>{% else %}<div class="empty-state"><h2>Your bag is empty.</h2><p class="section-sub">Find something useful for the way you live.</p><a class="button-dark" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% endif %}</section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
