<header class="site-header"><a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a><div class="header-inner"><button class="icon-button mobile-menu" data-menu-toggle aria-label="{{ 'accessibility.menu' | t }}">☰</button><a class="brand" href="{{ routes.root_url }}">Cart<span>Lane</span></a><nav class="nav" aria-label="Primary">{% if linklists.main-menu.links.size > 0 %}{% for link in linklists.main-menu.links limit: 6 %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Catalog</a>{% endif %}</nav><div class="header-actions"><a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'accessibility.search' | t }}">⌕</a><a class="icon-button" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">▢<span class="cart-count">{{ cart.item_count }}</span></a></div></div><nav class="mobile-nav" data-mobile-menu aria-label="Mobile navigation">{% if linklists.main-menu.links.size > 0 %}{% for link in linklists.main-menu.links limit: 6 %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Catalog</a>{% endif %}</nav></header>
{% schema %}{"name":"Header","settings":[]}{% endschema %}
